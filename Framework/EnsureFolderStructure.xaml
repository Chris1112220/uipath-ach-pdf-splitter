    <ui:InvokeCode ContinueOnError="{x:Null}" Code="if (!System.IO.Directory.Exists(in_SourceFolderPath))&#xA;{&#xA;    throw new System.IO.DirectoryNotFoundException(&#xA;        &quot;The expected ACH source folder was not found: &quot; +&#xA;        in_SourceFolderPath);&#xA;}" DisplayName="02 - Verify Source Folder Exists" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Language="CSharp">
