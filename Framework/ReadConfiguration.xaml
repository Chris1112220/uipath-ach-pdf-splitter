  <Sequence DisplayName="Read Configuration" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dtSettings" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="configDictionary" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Purpose" sap2010:WorkflowViewState.IdRef="Comment_1" Text="Read Config.xlsx, validate the Settings worksheet, build a case-insensitive configuration dictionary, and return the validated configuration to the caller." />
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="if (string.IsNullOrWhiteSpace(in_ConfigPath))&#xA;{&#xA;    throw new System.ArgumentException(&#xA;        &quot;Configuration path cannot be blank.&quot;,&#xA;        &quot;in_ConfigPath&quot;);&#xA;}&#xA;&#xA;if (!System.IO.File.Exists(in_ConfigPath))&#xA;{&#xA;    throw new System.IO.FileNotFoundException(&#xA;        &quot;Config.xlsx was not found at the expected path.&quot;,&#xA;        in_ConfigPath);&#xA;}" DisplayName="01 - Validate Config Path" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_ConfigPath">
          <CSharpValue x:TypeArguments="x:String" sap2010:WorkflowViewState.IdRef="CSharpValue`1_1">in_ConfigPath</CSharpValue>
        </InArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:ReadRange Range="{x:Null}" AddHeaders="True" DisplayName="02 - Read Settings Sheet" sap2010:WorkflowViewState.IdRef="ReadRange_1" SheetName="Settings">
      <ui:ReadRange.DataTable>
        <OutArgument x:TypeArguments="sd:DataTable">
          <CSharpReference x:TypeArguments="sd:DataTable" sap2010:WorkflowViewState.IdRef="CSharpReference`1_1">dtSettings</CSharpReference>
        </OutArgument>
      </ui:ReadRange.DataTable>
      <ui:ReadRange.WorkbookPath>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String" sap2010:WorkflowViewState.IdRef="CSharpValue`1_2">in_ConfigPath</CSharpValue>
        </InArgument>
      </ui:ReadRange.WorkbookPath>
    </ui:ReadRange>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="if (dtSettings == null)&#xA;{&#xA;    throw new System.InvalidOperationException(&#xA;        &quot;The Settings worksheet did not return any tabular data.&quot;);&#xA;}&#xA;&#xA;if (!dtSettings.Columns.Contains(&quot;Key&quot;))&#xA;{&#xA;    throw new System.InvalidOperationException(&#xA;        &quot;The Settings worksheet must contain a column named 'Key'.&quot;);&#xA;}&#xA;&#xA;if (!dtSettings.Columns.Contains(&quot;Value&quot;))&#xA;{&#xA;    throw new System.InvalidOperationException(&#xA;        &quot;The Settings worksheet must contain a column named 'Value'.&quot;);&#xA;}" DisplayName="03 - Validate Settings Table" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Language="CSharp">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="dtSettings">
          <CSharpValue x:TypeArguments="sd:DataTable" sap2010:WorkflowViewState.IdRef="CSharpValue`1_3">dtSettings</CSharpValue>
        </InArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="System.Collections.Generic.Dictionary&lt;string, string&gt; config =&#xA;    new System.Collections.Generic.Dictionary&lt;string, string&gt;(&#xA;        System.StringComparer.OrdinalIgnoreCase);&#xA;&#xA;foreach (System.Data.DataRow row in dtSettings.Rows)&#xA;{&#xA;    string key = System.Convert.ToString(row[&quot;Key&quot;]);&#xA;    string value = System.Convert.ToString(row[&quot;Value&quot;]);&#xA;&#xA;    key = key == null ? string.Empty : key.Trim();&#xA;    value = value == null ? string.Empty : value.Trim();&#xA;&#xA;    if (string.IsNullOrWhiteSpace(key))&#xA;    {&#xA;        continue;&#xA;    }&#xA;&#xA;    if (config.ContainsKey(key))&#xA;    {&#xA;        throw new System.InvalidOperationException(&#xA;            &quot;Duplicate configuration key found: &quot; + key);&#xA;    }&#xA;&#xA;    config.Add(key, value);&#xA;}&#xA;&#xA;out_ConfigDictionary = config;" DisplayName="04 - Build Config Dictionary" sap2010:WorkflowViewState.IdRef="InvokeCode_3" Language="CSharp">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="dtSettings">
          <CSharpValue x:TypeArguments="sd:DataTable" sap2010:WorkflowViewState.IdRef="CSharpValue`1_4">dtSettings</CSharpValue>
        </InArgument>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="out_ConfigDictionary">
          <CSharpReference x:TypeArguments="scg:Dictionary(x:String, x:String)" sap2010:WorkflowViewState.IdRef="CSharpReference`1_2">configDictionary</CSharpReference>
        </OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="string[] requiredKeys = new string[]&#xA;{&#xA;    &quot;ConfigVersion&quot;,&#xA;    &quot;ProjectName&quot;,&#xA;    &quot;DataRoot&quot;,&#xA;    &quot;FiscalYearStartMonth&quot;,&#xA;    &quot;FiscalYearFolderPattern&quot;,&#xA;    &quot;BankActivityFolderName&quot;,&#xA;    &quot;FiscalPeriodFolderPattern&quot;,&#xA;    &quot;SourceSubfolderName&quot;,&#xA;    &quot;BreakdownSubfolderName&quot;,&#xA;    &quot;SourceFilePattern&quot;,&#xA;    &quot;DailyOutputFolderDateFormat&quot;,&#xA;    &quot;OutputFileNameFormat&quot;,&#xA;    &quot;FileStableMinutes&quot;,&#xA;    &quot;HashAlgorithm&quot;,&#xA;    &quot;AutomationFolderName&quot;,&#xA;    &quot;AutomationAppFolderName&quot;,&#xA;    &quot;StateFolderName&quot;,&#xA;    &quot;LogsFolderName&quot;,&#xA;    &quot;ReportingFolderName&quot;,&#xA;    &quot;ManifestFileName&quot;,&#xA;    &quot;RunLogFileName&quot;,&#xA;    &quot;SummaryWorkbookName&quot;&#xA;};&#xA;&#xA;foreach (string requiredKey in requiredKeys)&#xA;{&#xA;    if (!config.ContainsKey(requiredKey))&#xA;    {&#xA;        throw new System.InvalidOperationException(&#xA;            &quot;Required configuration key is missing: &quot; + requiredKey);&#xA;    }&#xA;&#xA;    if (string.IsNullOrWhiteSpace(config[requiredKey]))&#xA;    {&#xA;        throw new System.InvalidOperationException(&#xA;            &quot;Required configuration value is blank: &quot; + requiredKey);&#xA;    }&#xA;}" DisplayName="05 - Validate Required Settings" sap2010:WorkflowViewState.IdRef="InvokeCode_4" Language="CSharp">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="config">
          <CSharpValue x:TypeArguments="scg:Dictionary(x:String, x:String)" sap2010:WorkflowViewState.IdRef="CSharpValue`1_5">configDictionary</CSharpValue>
        </InArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="int fiscalYearStartMonth;&#xA;bool fiscalYearIsValid = int.TryParse(&#xA;    config[&quot;FiscalYearStartMonth&quot;],&#xA;    out fiscalYearStartMonth);&#xA;&#xA;if (!fiscalYearIsValid ||&#xA;    fiscalYearStartMonth &lt; 1 ||&#xA;    fiscalYearStartMonth &gt; 12)&#xA;{&#xA;    throw new System.InvalidOperationException(&#xA;        &quot;FiscalYearStartMonth must be a whole number from 1 through 12.&quot;);&#xA;}&#xA;&#xA;int fileStableMinutes;&#xA;bool stableMinutesIsValid = int.TryParse(&#xA;    config[&quot;FileStableMinutes&quot;],&#xA;    out fileStableMinutes);&#xA;&#xA;if (!stableMinutesIsValid ||&#xA;    fileStableMinutes &lt; 0 ||&#xA;    fileStableMinutes &gt; 120)&#xA;{&#xA;    throw new System.InvalidOperationException(&#xA;        &quot;FileStableMinutes must be a whole number from 0 through 120.&quot;);&#xA;}&#xA;&#xA;if (!string.Equals(&#xA;        config[&quot;HashAlgorithm&quot;],&#xA;        &quot;SHA256&quot;,&#xA;        System.StringComparison.OrdinalIgnoreCase))&#xA;{&#xA;    throw new System.InvalidOperationException(&#xA;        &quot;HashAlgorithm must currently be SHA256.&quot;);&#xA;}" DisplayName="06 - Validate Typed Settings" sap2010:WorkflowViewState.IdRef="InvokeCode_5" Language="CSharp">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="config">
          <CSharpValue x:TypeArguments="scg:Dictionary(x:String, x:String)" sap2010:WorkflowViewState.IdRef="CSharpValue`1_6">configDictionary</CSharpValue>
        </InArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <Assign DisplayName="07 - Return Config Dictionary" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">
          <CSharpReference x:TypeArguments="scg:Dictionary(x:String, x:String)" sap2010:WorkflowViewState.IdRef="CSharpReference`1_3">out_Config</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">
          <CSharpValue x:TypeArguments="scg:Dictionary(x:String, x:String)" sap2010:WorkflowViewState.IdRef="CSharpValue`1_7">configDictionary</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="08 - Build Success Message" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String" sap2010:WorkflowViewState.IdRef="CSharpReference`1_4">out_Message</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String" sap2010:WorkflowViewState.IdRef="CSharpValue`1_8">"Loaded and validated " + configDictionary.Count.ToString() + " configuration settings from " + in_ConfigPath + "."</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>