;    new System.IO.FileInfo(in_ManifestPath).Length &gt; 0)&#xD;&#xA;{&#xD;&#xA;    string[] lines =&#xD;&#xA;        System.IO.File.ReadAllLines(in_ManifestPath);&#xD;&#xA;&#xD;&#xA;    if (lines.Length &gt; 0)&#xD;&#xA;    {&#xD;&#xA;        string[] headers =&#xD;&#xA;            parseCsvLine(lines[0]);&#xD;&#xA;&#xD;&#xA;        int hashIndex =&#xD;&#xA;            System.Array.FindIndex(&#xD;&#xA;                headers,&#xD;&#xA;                header =&gt; string.Equals(&#xD;&#xA;                    header == null ? string.Empty : header.Trim(),&#xD;&#xA;                    &quot;FileHash&quot;,&#xD;&#xA;                    System.StringComparison.OrdinalIgnoreCase));&#xD;&#xA;&#xD;&#xA;        int statusIndex =&#xD;&#xA;            System.Array.FindIndex(&#xD;&#xA;                headers,&#xD;&#xA;                header =&gt; string.Equals(&#xD;&#xA;                    header == null ? string.Empty : header.Trim(),&#xD;&#xA;                    &quot;Status&quot;,&#xD;&#xA;                    System.StringComparison.OrdinalIgnoreCase));&#xD;&#xA;&#xD;&#xA;        if (hashIndex &lt; 0 || statusIndex &lt; 0)&#xD;&#xA;        {&#xD;&#xA;            throw new System.InvalidOperationException(&#xD;&#xA;                &quot;ProcessedSourceManifest.csv must contain FileHash and Status columns.&quot;);&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        for (int i = 1; i &lt; lines.Length; i++)&#xD;&#xA;        {&#xD;&#xA;            if (string.IsNullOrWhiteSpace(lines[i]))&#xD;&#xA;            {&#xD;&#xA;                continue;&#xD;&#xA;            }&#xD;&#xA;&#xD;&#xA;            string[] fields =&#xD;&#xA;                parseCsvLine(lines[i]);&#xD;&#xA;&#xD;&#xA;            if (fields.Length &lt;=&#xD;&#xA;                System.Math.Max(hashIndex, statusIndex))&#xD;&#xA;            {&#xD;&#xA;                continue;&#xD;&#xA;            }&#xD;&#xA;&#xD;&#xA;            manifestRowCount++;&#xD;&#xA;&#xD;&#xA;            string fileHash =&#xD;&#xA;                fields[hashIndex] == null&#xD;&#xA;                    ? string.Empty&#xD;&#xA;                    : fields[hashIndex].Trim();&#xD;&#xA;&#xD;&#xA;            string status =&#xD;&#xA;                fields[statusIndex] == null&#xD;&#xA;                    ? string.Empty&#xD;&#xA;                    : fields[statusIndex].Trim();&#xD;&#xA;&#xD;&#xA;            if (!string.IsNullOrWhiteSpace(fileHash) &amp;&amp;&#xD;&#xA;                string.Equals(&#xD;&#xA;                    status,&#xD;&#xA;                    &quot;Success&quot;,&#xD;&#xA;                    System.StringComparison.OrdinalIgnoreCase))&#xD;&#xA;            {&#xD;&#xA;                processedHashes.Add(fileHash);&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;out_ProcessedHashes = processedHashes;&#xD;&#xA;out_ManifestRowCount = manifestRowCount;" ContinueOnError="{x:Null}" DisplayName="02 - Load Successful Hashes" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Language="CSharp">
